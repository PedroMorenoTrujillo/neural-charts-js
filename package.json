{
  "name": "@neural-charts/web",
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs/WEB-API.md",
    "docs/CUSTOM-CONTENT.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cartesian": {
      "types": "./dist/cartesian.d.ts",
      "import": "./dist/cartesian.js"
    },
    "./financial": {
      "types": "./dist/financial.d.ts",
      "import": "./dist/financial.js"
    },
    "./drilldown": {
      "types": "./dist/drilldown.d.ts",
      "import": "./dist/drilldown.js"
    },
    "./panels": {
      "types": "./dist/panels.d.ts",
      "import": "./dist/panels.js"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@neural-charts/core": "0.1.5"
  },
  "homepage": "https://charts.neuralui.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroMorenoTrujillo/neural-charts-js.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prebuild": "node tooling/write-core-version.mjs",
    "build": "tsc -p tsconfig.json",
    "benchmark": "npm run build && node tooling/benchmark.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm test && node tooling/verify.mjs",
    "pack:local": "npm run build && node tooling/pack-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
